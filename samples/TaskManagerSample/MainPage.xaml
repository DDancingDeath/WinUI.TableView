<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="TaskManagerSample.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TaskManagerSample"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tableView="using:WinUI.TableView"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Task Manager style: zero spacing between rows -->
        <Style x:Key="TaskManagerRowStyle" TargetType="tableView:TableViewRow">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Default cell style: zero corner radius, no hover effect -->
        <Style TargetType="tableView:TableViewCell">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="tableView:TableViewCell">
                        <Grid Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}">
                            <ContentPresenter 
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <!-- No visual changes on hover -->
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <!-- No visual changes on press -->
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric cell style: zero padding with uniform blue background, no hover effect -->
        <Style x:Key="MetricCellStyle" TargetType="tableView:TableViewCell">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{ThemeResource MetricColumnBackgroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="tableView:TableViewCell">
                        <Grid Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}">
                            <ContentPresenter 
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <!-- No visual changes on hover -->
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <!-- No visual changes on press -->
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Name column: colored brand tile (parents) or plain indented icon (children) -->
        <DataTemplate x:Key="NameCellTemplate">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        Margin="{Binding NameIndentMargin}">
                <!-- Colored brand tile: top-level parent processes only -->
                <Border Width="18" Height="18" CornerRadius="3"
                        Background="{Binding IconBackground}"
                        Visibility="{Binding ParentIconVisibility}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="10" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- Plain icon: child sub-processes (same 18px box for alignment) -->
                <Grid Width="18" Height="18" Visibility="{Binding ChildIconVisibility}">
                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="13"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                
                <!-- Critical resource indicator: red warning icon -->
                <FontIcon Glyph="&#xE7BA;" FontSize="12" 
                          Foreground="#E74856"
                          ToolTipService.ToolTip="Critical: High CPU and Memory"
                          Visibility="{Binding IsCriticalResourceVisibility}" />
                
                <!-- High CPU indicator: orange fire icon -->
                <FontIcon Glyph="&#xE91B;" FontSize="12" 
                          Foreground="#FF8C00"
                          ToolTipService.ToolTip="High CPU Usage"
                          Visibility="{Binding IsHighCpuResourceVisibility}" />
                
                <!-- High Memory indicator: blue/purple icon -->
                <FontIcon Glyph="&#xE950;" FontSize="12" 
                          Foreground="#9B59B6"
                          ToolTipService.ToolTip="High Memory Usage"
                          Visibility="{Binding IsHighMemoryResourceVisibility}" />
            </StackPanel>
        </DataTemplate>

        <!-- Status column: Suspended yellow icon  /  Efficiency mode leaf -->
        <DataTemplate x:Key="StatusCellTemplate">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <!-- Suspended: yellow pause badge -->
                <FontIcon Glyph="&#xF8A8;" FontSize="13" Foreground="#D4A017"
                          Visibility="{Binding IsSuspendedVisibility}" />
                <!-- Efficiency mode: dimmed label + green leaf -->
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasStatusText}" />
                <FontIcon Glyph="&#xEC0A;" FontSize="12" Foreground="#5DB85D"
                          Visibility="{Binding IsEfficiencyMode}" />
            </StackPanel>
        </DataTemplate>

        <!-- CPU cell with heat-map background — numbers right-aligned like real TM -->
        <DataTemplate x:Key="CpuCellTemplate">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Heat-map overlay for high values only -->
                <Border Background="{Binding CpuBackground}" Visibility="{Binding HasCpuHeatMap}" />
                <TextBlock Text="{Binding CpuDisplay}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
            </Grid>
        </DataTemplate>

        <!-- Memory cell with heat-map background -->
        <DataTemplate x:Key="MemoryCellTemplate">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Heat-map overlay for high values only -->
                <Border Background="{Binding MemoryBackground}" Visibility="{Binding HasMemoryHeatMap}" />
                <TextBlock Text="{Binding MemoryDisplay}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
            </Grid>
        </DataTemplate>

        <!-- Disk cell with heat-map background -->
        <DataTemplate x:Key="DiskCellTemplate">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Heat-map overlay for high values only -->
                <Border Background="{Binding DiskBackground}" Visibility="{Binding HasDiskHeatMap}" />
                <TextBlock Text="{Binding DiskDisplay}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
            </Grid>
        </DataTemplate>

        <!-- Network cell with heat-map background -->
        <DataTemplate x:Key="NetworkCellTemplate">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Heat-map overlay for high values only -->
                <Border Background="{Binding NetworkBackground}" Visibility="{Binding HasNetworkHeatMap}" />
                <TextBlock Text="{Binding NetworkDisplay}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Custom title bar ═══ -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0" Grid.ColumnSpan="2"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        Margin="12,0,16,0" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                <TextBlock Text="Task Manager" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="1"
                            PlaceholderText="Type a name, publisher, or PID to search"
                            QueryIcon="Find"
                            MaxWidth="460"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextChanged="OnSearchTextChanged" />
        </Grid>

        <!-- ═══ Left navigation sidebar ═══ -->
        <Grid Grid.Row="1"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4" Padding="4,8,4,0">
                <Button Style="{StaticResource SubtleButtonStyle}" Width="40" Height="36"
                        HorizontalAlignment="Center" Padding="0"
                        ToolTipService.ToolTip="Navigation">
                    <FontIcon Glyph="&#xE700;" FontSize="16" />
                </Button>
                <!-- Processes (selected) -->
                <Button Style="{StaticResource SubtleButtonStyle}" Width="40" Height="36"
                        HorizontalAlignment="Center" Padding="0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        ToolTipService.ToolTip="Processes">
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                </Button>
                <!-- Performance -->
                <Button Style="{StaticResource SubtleButtonStyle}" Width="40" Height="36"
                        HorizontalAlignment="Center" Padding="0"
                        ToolTipService.ToolTip="Performance">
                    <FontIcon Glyph="&#xE9F9;" FontSize="16" />
                </Button>
                <!-- App history -->
                <Button Style="{StaticResource SubtleButtonStyle}" Width="40" Height="36"
                        HorizontalAlignment="Center" Padding="0"
                        ToolTipService.ToolTip="App history">
                    <FontIcon Glyph="&#xE81C;" FontSize="16" />
                </Button>
                <!-- Startup apps -->
                <Button Style="{StaticResource SubtleButtonStyle}" Width="40" Height="36"
                        HorizontalAlignment="Center" Padding="0"
                        ToolTipService.ToolTip="Startup apps">
                    <FontIcon Glyph="&#xE7B5;" FontSize="16" />
                </Button>
                <!-- Users -->
                <Button Style="{StaticResource SubtleButtonStyle}" Width="40" Height="36"
                        HorizontalAlignment="Center" Padding="0"
                        ToolTipService.ToolTip="Users">
                    <FontIcon Glyph="&#xE77B;" FontSize="16" />
                </Button>
                <!-- Details -->
                <Button Style="{StaticResource SubtleButtonStyle}" Width="40" Height="36"
                        HorizontalAlignment="Center" Padding="0"
                        ToolTipService.ToolTip="Details">
                    <FontIcon Glyph="&#xE8A1;" FontSize="16" />
                </Button>
                <!-- Services -->
                <Button Style="{StaticResource SubtleButtonStyle}" Width="40" Height="36"
                        HorizontalAlignment="Center" Padding="0"
                        ToolTipService.ToolTip="Services">
                    <FontIcon Glyph="&#xE912;" FontSize="16" />
                </Button>
            </StackPanel>

            <!-- Settings gear at bottom -->
            <Button Grid.Row="1" Style="{StaticResource SubtleButtonStyle}"
                    Width="40" Height="36" HorizontalAlignment="Center"
                    Padding="0" Margin="0,0,0,8"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <!-- ═══ Main content area ═══ -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Top bar: "Processes" + Action buttons ── -->
            <Grid Padding="16,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Processes" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6"
                            ToolTipService.ToolTip="Run new task">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A0;" FontSize="14" />
                            <TextBlock Text="Run new task" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6"
                            ToolTipService.ToolTip="End task" Click="OnEndTaskClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                            <TextBlock Text="End task" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6"
                            ToolTipService.ToolTip="Efficiency mode">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEC0A;" FontSize="14" />
                            <TextBlock Text="Efficiency mode" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6"
                            ToolTipService.ToolTip="More options">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

                <tableView:TableView
                x:Name="ProcessTable"
                Grid.Row="1"
                AutoGenerateColumns="False"
                ChildrenPath="Children"
                GroupByPath="Category"
                ShowGroupHeaders="True"
                ShowGroupItemCount="True"
                IsHierarchicalEnabled="True"
                IsExpandedPath="IsExpanded"
                HeadersVisibility="Columns"
                ItemsSource="{x:Bind Processes}"
                FrozenColumnCount="1"
                RowHeight="28"
                RowMinHeight="24"
                SelectionMode="Single"
                SelectionUnit="Row"
                GridLinesVisibility="None"
                HeaderGridLinesVisibility="All"
                ItemContainerStyle="{StaticResource TaskManagerRowStyle}">
                <tableView:TableView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </tableView:TableView.ItemsPanel>
                <tableView:TableView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Switch to" IsEnabled="False" />
                        <MenuFlyoutItem Text="Bring to front" IsEnabled="False" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="End task" Click="OnEndTaskClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Efficiency mode" IsEnabled="False">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEC0A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Open file location" IsEnabled="False">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8DA;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Search online" IsEnabled="False">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE721;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Properties" IsEnabled="False">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Create dump file" IsEnabled="False" />
                    </MenuFlyout>
                </tableView:TableView.ContextFlyout>
                <tableView:TableView.Columns>
                    <tableView:TableViewTemplateColumn Header="Name"
                        CellTemplate="{StaticResource NameCellTemplate}"
                        MinWidth="260" Width="*"
                        CanSort="True" SortMemberPath="Name" />
                    <tableView:TableViewTemplateColumn Header="Status"
                        CellTemplate="{StaticResource StatusCellTemplate}"
                        MinWidth="80" Width="110"
                        CanSort="True" SortMemberPath="StatusText" />
                    <tableView:TableViewTemplateColumn x:Name="CpuColumn" Header="CPU"
                        CellTemplate="{StaticResource CpuCellTemplate}"
                        CellStyle="{StaticResource MetricCellStyle}"
                        MinWidth="60" Width="80"
                        CanSort="True" SortMemberPath="CpuPercent" />
                    <tableView:TableViewTemplateColumn x:Name="MemoryColumn" Header="Memory"
                        CellTemplate="{StaticResource MemoryCellTemplate}"
                        CellStyle="{StaticResource MetricCellStyle}"
                        MinWidth="85" Width="105"
                        CanSort="True" SortMemberPath="MemoryMB" />
                    <tableView:TableViewTemplateColumn x:Name="DiskColumn" Header="Disk"
                        CellTemplate="{StaticResource DiskCellTemplate}"
                        CellStyle="{StaticResource MetricCellStyle}"
                        MinWidth="65" Width="80"
                        CanSort="True" SortMemberPath="DiskMBps" />
                    <tableView:TableViewTemplateColumn x:Name="NetworkColumn" Header="Network"
                        CellTemplate="{StaticResource NetworkCellTemplate}"
                        CellStyle="{StaticResource MetricCellStyle}"
                        MinWidth="75" Width="90"
                        CanSort="True" SortMemberPath="NetworkMbps" />
                </tableView:TableView.Columns>
            </tableView:TableView>

            <!-- ── Bottom Status Bar ── -->
            <Border Grid.Row="2"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <StackPanel Orientation="Horizontal" Spacing="24" Height="28">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="CPU" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusCpuText" Text="0%" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="Memory" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusRamText" Text="0 GB (0%)" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="Disk" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusDiskText" Text="0%" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="Network" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusNetText" Text="0 Kbps" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
