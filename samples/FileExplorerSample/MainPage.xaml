<Page
x:Class="FileExplorerSample.MainPage"
x:Name="RootPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:tableView="using:WinUI.TableView"
mc:Ignorable="d"
Background="{ThemeResource FileExplorerBackgroundBrush}">

    <Page.Resources>
        <!-- Override cell backgrounds to be transparent (we'll use row-level styling instead) -->
        <SolidColorBrush x:Key="TableViewCellBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TableViewCellBackgroundSelected" Color="Transparent" />
        
        <!-- Custom template for Name column with icon -->
        <DataTemplate x:Key="NameColumnTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" />
                <TextBlock Text="{Binding Name}" 
                          TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150" MaxWidth="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" 
                Grid.ColumnSpan="3"
                Background="{ThemeResource FileExplorerTitleBarBackgroundBrush}"
                BorderBrush="{ThemeResource FileExplorerBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="File Explorer - TableView Demo"
                          FontSize="16"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center" />

                <ToggleButton x:Name="DarkModeToggle"
                             Grid.Column="1"
                             ToolTipService.ToolTip="Toggle Dark Mode"
                             Click="DarkModeToggle_Click"
                             VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE793;" FontSize="16" />
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Navigation/Address Bar -->
        <Grid Grid.Row="1" 
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Padding="16,8"
              Background="{ThemeResource FileExplorerBackgroundBrush}"
              BorderBrush="{ThemeResource FileExplorerBorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Buttons -->
            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Back"
                    Click="BackButton_Click"
                    Margin="0,0,4,0">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>

            <Button x:Name="ForwardButton"
                    Grid.Column="1"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Forward"
                    Click="ForwardButton_Click"
                    Margin="0,0,4,0">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>

            <Button x:Name="UpButton"
                    Grid.Column="2"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Up one level"
                    Click="UpButton_Click"
                    Margin="0,0,8,0">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>

            <!-- Address Bar -->
            <TextBox x:Name="AddressBar"
                     Grid.Column="3"
                     Text="{x:Bind CurrentPath, Mode=OneWay}"
                     KeyDown="AddressBar_KeyDown"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />

            <!-- Refresh Button -->
            <Button x:Name="RefreshButton"
                    Grid.Column="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Refresh"
                    Click="RefreshButton_Click">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Side Navigation Panel -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Background="{ThemeResource FileExplorerSidebarBackgroundBrush}"
                BorderBrush="{ThemeResource FileExplorerBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="8">
            <ScrollViewer>
                <StackPanel Spacing="4">
                    <TextBlock Text="Quick Access"
                              FontWeight="SemiBold"
                              Margin="8,8,8,12"
                              FontSize="14" />

                    <ListView x:Name="LocationsListView"
                              ItemsSource="{x:Bind Locations}"
                              SelectionMode="Single"
                              SelectionChanged="LocationsListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="8,6">
                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource FileExplorerSidebarListViewItemStyle}" />
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <TextBlock Text="This PC"
                              FontWeight="SemiBold"
                              Margin="8,16,8,12"
                              FontSize="14" />

                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="DriveButton_Click"
                            Tag="C:\">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEDA2;" FontSize="16" />
                            <TextBlock Text="Local Disk (C:)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Resizable Splitter -->
        <Border Grid.Row="2" 
                Grid.Column="1"
                x:Name="Splitter"
                Width="8"
                Background="Transparent"
                PointerEntered="Splitter_PointerEntered"
                PointerExited="Splitter_PointerExited"
                PointerPressed="Splitter_PointerPressed"
                PointerMoved="Splitter_PointerMoved"
                PointerReleased="Splitter_PointerReleased" />

        <!-- Main Content Area with TableView -->
        <Grid Grid.Row="2" Grid.Column="2" Padding="16" Background="{ThemeResource FileExplorerBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" 
                       Orientation="Horizontal" 
                       Spacing="8"
                       Margin="0,0,0,12">
                <Button x:Name="NewFolderButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="New folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>

                <Button x:Name="ViewButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="View options">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE890;" FontSize="16" />
                        <TextBlock Text="View" />
                    </StackPanel>
                </Button>

                <Button x:Name="SortButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Sort">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8CB;" FontSize="16" />
                        <TextBlock Text="Sort" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- TableView for File List -->
            <tableView:TableView x:Name="FileTableView"
                                Grid.Row="1"
                                ItemsSource="{x:Bind FileItems}"
                                AutoGenerateColumns="False"
                                SelectionMode="Extended"
                                ShowExportOptions="True"
                                CornerButtonMode="Options"
                                ShowGroupHeaders="False"
                                Background="{ThemeResource FileExplorerBackgroundBrush}"
                                GridLinesVisibility="None"
                                ItemContainerStyle="{StaticResource FileExplorerListViewItemStyle}"
                                DoubleTapped="FileTableView_DoubleTapped"
                                SelectionChanged="FileTableView_SelectionChanged">

                <tableView:TableView.Columns>
                    <!-- Name Column with Icon -->
                    <tableView:TableViewTemplateColumn Header="Name" 
                                                      Width="300"
                                                      CanSort="True"
                                                      Tag="Name"
                                                      CellTemplate="{StaticResource NameColumnTemplate}" />

                    <!-- Date Modified Column -->
                    <tableView:TableViewTextColumn Header="Date modified"
                                                  Width="180"
                                                  Binding="{Binding DateModifiedDisplay}"
                                                  CanSort="True"
                                                  Tag="DateModified" />

                    <!-- Type Column -->
                    <tableView:TableViewTextColumn Header="Type"
                                                  Width="200"
                                                  Binding="{Binding Type}"
                                                  CanSort="True"
                                                  Tag="Type" />

                    <!-- Size Column -->
                    <tableView:TableViewTextColumn Header="Size"
                                                  Width="120"
                                                  Binding="{Binding SizeDisplay}"
                                                  CanSort="True"
                                                  Tag="Size" />
                </tableView:TableView.Columns>
            </tableView:TableView>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Grid.ColumnSpan="3"
                Background="{ThemeResource FileExplorerTitleBarBackgroundBrush}"
                BorderBrush="{ThemeResource FileExplorerBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                          Text="{x:Bind StatusMessage, Mode=OneWay}"
                          VerticalAlignment="Center" />

                <TextBlock x:Name="SelectionInfo"
                          Grid.Column="1"
                          Text="{x:Bind SelectionText, Mode=OneWay}"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
