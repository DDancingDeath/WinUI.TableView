<Page
x:Class="FileExplorerSample.MainPage"
x:Name="RootPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:tableView="using:WinUI.TableView"
mc:Ignorable="d"
Background="{ThemeResource FileExplorerBackgroundBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/TableViewColumnHeaderStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Override cell backgrounds to be transparent (we'll use row-level styling instead) -->
            <SolidColorBrush x:Key="TableViewCellBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TableViewCellBackgroundSelected" Color="Transparent" />
            
            <!-- Override header styling - transparent/white background -->
            <SolidColorBrush x:Key="TableViewHeaderRowBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TableViewHeaderBackgroundPointerOver" Color="#E6F3FF" />
            <SolidColorBrush x:Key="TableViewHeaderBackgroundPressed" Color="#CCE8FF" />
            
            <!-- Remove grid lines and borders -->
            <SolidColorBrush x:Key="TableViewBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TableViewHorizontalGridLineStroke" Color="Transparent" />
            <SolidColorBrush x:Key="TableViewVerticalGridLineStroke" Color="Transparent" />
            
            <!-- Override OptionsButtonIcon to use ChevronDown arrow instead of three dots -->
            <x:String x:Key="OptionsButtonIcon">&#xE70D;</x:String>
            
            <!-- Override the filter dropdown dimensions for larger File Explorer-style filter -->
            <x:Double x:Key="FileExplorerFilterDropdownWidth">350</x:Double>
            <x:Double x:Key="FileExplorerFilterDropdownHeight">400</x:Double>
            
            <!-- Custom template for Name column with icon -->
        <DataTemplate x:Key="NameColumnTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" />
                <TextBlock Text="{Binding Name}" 
                          TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Small Icon View Template -->
        <DataTemplate x:Key="SmallIconViewTemplate">
            <Grid Padding="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon Grid.Row="0" 
                         Glyph="{Binding IconGlyph}"
                         FontSize="16"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,2" />
                <TextBlock Grid.Row="1"
                          Text="{Binding Name}"
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="Wrap"
                          MaxLines="2"
                          HorizontalAlignment="Center"
                          TextAlignment="Center"
                          FontSize="11"
                          Margin="2,2,2,2" />
            </Grid>
        </DataTemplate>

        <!-- Medium Icon View Template -->
        <DataTemplate x:Key="MediumIconViewTemplate">
            <Grid Padding="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon Grid.Row="0" 
                         Glyph="{Binding IconGlyph}"
                         FontSize="32"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,4" />
                <TextBlock Grid.Row="1"
                          Text="{Binding Name}"
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="Wrap"
                          MaxLines="2"
                          HorizontalAlignment="Center"
                          TextAlignment="Center"
                          FontSize="12"
                          Margin="2,4,2,2" />
            </Grid>
        </DataTemplate>

        <!-- Large Icon View Template -->
        <DataTemplate x:Key="LargeIconViewTemplate">
            <Grid Padding="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon Grid.Row="0" 
                         Glyph="{Binding IconGlyph}"
                         FontSize="64"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,8" />
                <TextBlock Grid.Row="1"
                          Text="{Binding Name}"
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="Wrap"
                          MaxLines="2"
                          HorizontalAlignment="Center"
                          TextAlignment="Center"
                          FontSize="12"
                          Margin="2,4,2,4" />
            </Grid>
        </DataTemplate>

        <!-- Extra Large Icon View Template -->
        <DataTemplate x:Key="ExtraLargeIconViewTemplate">
            <Grid Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <FontIcon Grid.Row="0" 
                         Glyph="{Binding IconGlyph}"
                         FontSize="80"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,4,0,4" />
                <TextBlock Grid.Row="1"
                          Text="{Binding Name}"
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="Wrap"
                          MaxLines="3"
                          HorizontalAlignment="Center"
                          TextAlignment="Center"
                          VerticalAlignment="Top"
                          FontSize="14"
                          FontWeight="Normal"
                          Margin="4,12,4,8" />
            </Grid>
        </DataTemplate>

        <!-- List View Template -->
        <DataTemplate x:Key="ListViewTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" />
                <TextBlock Text="{Binding Name}" 
                          TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Tiles View Template -->
        <DataTemplate x:Key="TilesViewTemplate">
            <Grid Width="250" Height="60" Padding="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" 
                         Glyph="{Binding IconGlyph}" 
                         FontSize="32"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                              FontWeight="SemiBold"
                              TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Type}"
                              Foreground="{ThemeResource FileExplorerSubtleTextBrush}"
                              FontSize="12"
                              TextTrimming="CharacterEllipsis"
                              Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Content View Template -->
        <DataTemplate x:Key="ContentViewTemplate">
            <Grid Width="300" Height="80" Padding="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" 
                         Glyph="{Binding IconGlyph}" 
                         FontSize="48"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Name}"
                              FontWeight="SemiBold"
                              TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Type}"
                              Foreground="{ThemeResource FileExplorerSubtleTextBrush}"
                              FontSize="12"
                              TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DateModifiedDisplay}"
                              Foreground="{ThemeResource FileExplorerSubtleTextBrush}"
                              FontSize="11"
                              TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SizeDisplay}"
                              Foreground="{ThemeResource FileExplorerSubtleTextBrush}"
                              FontSize="11"
                              TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- GridView Item Style -->
        <Style x:Key="FileExplorerGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Menu Flyout for View Options -->
        <MenuFlyout x:Key="ViewMenuFlyout" x:Name="ViewMenuFlyout">
            <MenuFlyoutItem Text="Extra large icons" Tag="ExtraLargeIcons" Click="ViewModeMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7C5;" FontSize="16" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Large icons" Tag="LargeIcons" Click="ViewModeMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7C5;" FontSize="14" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Medium icons" Tag="MediumIcons" Click="ViewModeMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE80A;" FontSize="12" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Small icons" Tag="SmallIcons" Click="ViewModeMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF0E2;" FontSize="10" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="List" Tag="List" Click="ViewModeMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8FD;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Details" Tag="Details" Click="ViewModeMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE179;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Tiles" Tag="Tiles" Click="ViewModeMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF0E2;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Content" Tag="Content" Click="ViewModeMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF000;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!-- Menu Flyout for Sort Options -->
        <MenuFlyout x:Key="SortMenuFlyout" x:Name="SortMenuFlyout">
            <!-- Sort by properties -->
            <MenuFlyoutItem Text="Name" Tag="Name" Click="SortPropertyMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8D4;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Date modified" Tag="DateModified" Click="SortPropertyMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEC92;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Type" Tag="Type" Click="SortPropertyMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7C3;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Size" Tag="Size" Click="SortPropertyMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE2B4;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            
            <MenuFlyoutSeparator />
            
            <!-- Sort order with solid bullet indicator -->
            <MenuFlyoutItem x:Name="AscendingMenuItem"
                           Text="Ascending" 
                           Tag="Ascending" 
                           Click="SortOrderMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon x:Name="AscendingBullet" 
                             Glyph="&#xE915;" 
                             FontSize="8"
                             Visibility="Visible" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="DescendingMenuItem"
                           Text="Descending" 
                           Tag="Descending" 
                           Click="SortOrderMenuItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon x:Name="DescendingBullet" 
                             Glyph="&#xE915;" 
                             FontSize="8"
                             Visibility="Collapsed" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150" MaxWidth="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Tab Bar (replacing title bar) -->
        <Border Grid.Row="0" 
                Grid.ColumnSpan="3"
                Background="{ThemeResource FileExplorerBackgroundBrush}"
                BorderBrush="{ThemeResource FileExplorerBorderBrush}"
                BorderThickness="0,0,0,0"
                Padding="8,4,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Tab Strip -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- Active Tab -->
                    <Border Background="{ThemeResource FileExplorerTitleBarBackgroundBrush}"
                            BorderBrush="{ThemeResource FileExplorerBorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="8,8,0,0"
                            Padding="16,10,40,10"
                            MinWidth="220"
                            MaxWidth="350">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE838;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind TabTitle, Mode=OneWay}"
                                      FontSize="14"
                                      FontWeight="Normal"
                                      VerticalAlignment="Center"
                                      TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    
                    <!-- New Tab Button -->
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            ToolTipService.ToolTip="New tab">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- Dark Mode Toggle -->
                <ToggleButton x:Name="DarkModeToggle"
                             Grid.Column="1"
                             ToolTipService.ToolTip="Toggle Dark Mode"
                             Click="DarkModeToggle_Click"
                             Width="32"
                             Height="32"
                             Padding="0"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0">
                    <FontIcon Glyph="&#xE793;" FontSize="14" />
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Navigation/Address Bar -->
        <Grid Grid.Row="1" 
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Padding="16,8"
              Background="{ThemeResource FileExplorerBackgroundBrush}"
              BorderBrush="{ThemeResource FileExplorerBorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Buttons -->
            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Back"
                    Click="BackButton_Click"
                    Margin="0,0,4,0">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>

            <Button x:Name="ForwardButton"
                    Grid.Column="1"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Forward"
                    Click="ForwardButton_Click"
                    Margin="0,0,4,0">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>

            <Button x:Name="UpButton"
                    Grid.Column="2"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Up one level"
                    Click="UpButton_Click"
                    Margin="0,0,8,0">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>

            <!-- Address Bar -->
            <TextBox x:Name="AddressBar"
                     Grid.Column="3"
                     Text="{x:Bind CurrentPath, Mode=OneWay}"
                     KeyDown="AddressBar_KeyDown"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />

            <!-- Refresh Button -->
            <Button x:Name="RefreshButton"
                    Grid.Column="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Refresh"
                    Click="RefreshButton_Click">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Side Navigation Panel -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Background="{ThemeResource FileExplorerSidebarBackgroundBrush}"
                BorderBrush="{ThemeResource FileExplorerBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="8">
            <ScrollViewer>
                <StackPanel Spacing="4">
                    <TextBlock Text="Quick Access"
                              FontWeight="SemiBold"
                              Margin="8,8,8,12"
                              FontSize="14" />

                    <ListView x:Name="LocationsListView"
                              ItemsSource="{x:Bind Locations}"
                              SelectionMode="Single"
                              SelectionChanged="LocationsListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="8,6">
                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource FileExplorerSidebarListViewItemStyle}" />
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <TextBlock Text="This PC"
                              FontWeight="SemiBold"
                              Margin="8,16,8,12"
                              FontSize="14" />

                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="DriveButton_Click"
                            Tag="C:\">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEDA2;" FontSize="16" />
                            <TextBlock Text="Local Disk (C:)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Resizable Splitter -->
        <Border Grid.Row="2" 
                Grid.Column="1"
                x:Name="Splitter"
                Width="8"
                Background="Transparent"
                PointerEntered="Splitter_PointerEntered"
                PointerExited="Splitter_PointerExited"
                PointerPressed="Splitter_PointerPressed"
                PointerMoved="Splitter_PointerMoved"
                PointerReleased="Splitter_PointerReleased" />

        <!-- Main Content Area with TableView -->
        <Grid Grid.Row="2" Grid.Column="2" Padding="16" Background="{ThemeResource FileExplorerBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" 
                       Orientation="Horizontal" 
                       Spacing="8"
                       Margin="0,0,0,12">
                <Button x:Name="NewFolderButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="New folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>

                <Button x:Name="ViewButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="View options"
                        Click="ViewButton_Click"
                        Flyout="{StaticResource ViewMenuFlyout}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE890;" FontSize="16" />
                        <TextBlock Text="View" />
                    </StackPanel>
                </Button>

                <Button x:Name="SortButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Sort"
                        Click="SortButton_Click"
                        Flyout="{StaticResource SortMenuFlyout}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8CB;" FontSize="16" />
                        <TextBlock Text="Sort" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Multi-View Container -->
            <Grid Grid.Row="1">
                <!-- Details View (TableView) -->
                <tableView:TableView x:Name="DetailsTableView"
                                    ItemsSource="{x:Bind FileItems}"
                                    AutoGenerateColumns="False"
                                    SelectionMode="Extended"
                                    ShowExportOptions="True"
                                    CornerButtonMode="Options"
                                    ShowGroupHeaders="False"
                                    Background="{ThemeResource FileExplorerBackgroundBrush}"
                                    GridLinesVisibility="None"
                                    ItemContainerStyle="{StaticResource FileExplorerListViewItemStyle}"
                                    DoubleTapped="FileTableView_DoubleTapped"
                                    SelectionChanged="FileTableView_SelectionChanged">

                    <tableView:TableView.Columns>
                        <!-- Name Column with Icon -->
                        <tableView:TableViewTemplateColumn Header="Name" 
                                                          Width="300"
                                                          CanSort="True"
                                                          Tag="Name"
                                                          HeaderStyle="{StaticResource FileExplorerTableViewColumnHeaderStyle}"
                                                          CellTemplate="{StaticResource NameColumnTemplate}" />

                        <!-- Date Modified Column -->
                        <tableView:TableViewTextColumn Header="Date modified"
                                                      Width="180"
                                                      Binding="{Binding DateModifiedDisplay}"
                                                      CanSort="True"
                                                      Tag="DateModified"
                                                      HeaderStyle="{StaticResource FileExplorerTableViewColumnHeaderStyle}" />

                        <!-- Type Column -->
                        <tableView:TableViewTextColumn Header="Type"
                                                      Width="200"
                                                      Binding="{Binding Type}"
                                                      CanSort="True"
                                                      Tag="Type"
                                                      HeaderStyle="{StaticResource FileExplorerTableViewColumnHeaderStyle}" />

                        <!-- Size Column -->
                        <tableView:TableViewTextColumn Header="Size"
                                                      Width="120"
                                                      Binding="{Binding SizeDisplay}"
                                                      CanSort="True"
                                                      Tag="Size"
                                                      HeaderStyle="{StaticResource FileExplorerTableViewColumnHeaderStyle}" />
                    </tableView:TableView.Columns>
                </tableView:TableView>

                <!-- Icons View (GridView) -->
                <GridView x:Name="IconsGridView"
                         ItemsSource="{x:Bind FileItems}"
                         SelectionMode="Extended"
                         IsItemClickEnabled="True"
                         ItemClick="GridView_ItemClick"
                         SelectionChanged="GridView_SelectionChanged"
                         Background="{ThemeResource FileExplorerBackgroundBrush}"
                         ItemTemplate="{StaticResource LargeIconViewTemplate}"
                         ItemContainerStyle="{StaticResource FileExplorerGridViewItemStyle}"
                         Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" 
                                          ItemWidth="120" 
                                          ItemHeight="130" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <!-- List View (Compact ListView) -->
                <ListView x:Name="ListGridView"
                         ItemsSource="{x:Bind FileItems}"
                         SelectionMode="Extended"
                         IsItemClickEnabled="True"
                         ItemClick="ListView_ItemClick"
                         SelectionChanged="ListView_SelectionChanged"
                         Background="{ThemeResource FileExplorerBackgroundBrush}"
                         ItemTemplate="{StaticResource ListViewTemplate}"
                         ItemContainerStyle="{StaticResource FileExplorerListViewItemStyle}"
                         Visibility="Collapsed" />

                <!-- Tiles View (GridView with Tiles) -->
                <GridView x:Name="TilesGridView"
                         ItemsSource="{x:Bind FileItems}"
                         SelectionMode="Extended"
                         IsItemClickEnabled="True"
                         ItemClick="GridView_ItemClick"
                         SelectionChanged="GridView_SelectionChanged"
                         Background="{ThemeResource FileExplorerBackgroundBrush}"
                         ItemTemplate="{StaticResource TilesViewTemplate}"
                         ItemContainerStyle="{StaticResource FileExplorerGridViewItemStyle}"
                         Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" 
                                          ItemWidth="260" 
                                          ItemHeight="68" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <!-- Content View (GridView with Content) -->
                <GridView x:Name="ContentGridView"
                         ItemsSource="{x:Bind FileItems}"
                         SelectionMode="Extended"
                         IsItemClickEnabled="True"
                         ItemClick="GridView_ItemClick"
                         SelectionChanged="GridView_SelectionChanged"
                         Background="{ThemeResource FileExplorerBackgroundBrush}"
                         ItemTemplate="{StaticResource ContentViewTemplate}"
                         ItemContainerStyle="{StaticResource FileExplorerGridViewItemStyle}"
                         Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </Grid>
        </Grid>

        <!-- Enhanced Status Bar / Information Panel -->
        <Border Grid.Row="3"
                Grid.ColumnSpan="3"
                Background="{ThemeResource FileExplorerBackgroundBrush}"
                BorderBrush="{ThemeResource FileExplorerBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Item Count with Icon -->
                <StackPanel Grid.Column="0" 
                           Orientation="Horizontal" 
                           Spacing="8"
                           VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8FD;" 
                             FontSize="14" 
                             Foreground="{ThemeResource FileExplorerSubtleTextBrush}" />
                    <TextBlock x:Name="StatusText"
                              Text="{x:Bind StatusMessage, Mode=OneWay}"
                              FontSize="13"
                              Foreground="{ThemeResource FileExplorerTextBrush}"
                              VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Selection Info with Icon -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal" 
                           Spacing="8"
                           VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B2;" 
                             FontSize="14" 
                             Foreground="{ThemeResource FileExplorerSubtleTextBrush}"
                             Visibility="{x:Bind HasSelection, Mode=OneWay}" />
                    <TextBlock x:Name="SelectionInfo"
                              Text="{x:Bind SelectionText, Mode=OneWay}"
                              FontSize="13"
                              Foreground="{ThemeResource FileExplorerTextBrush}"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

