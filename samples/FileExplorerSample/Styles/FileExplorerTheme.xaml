<ResourceDictionary
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:tableView="using:WinUI.TableView">

    <!-- Light Theme Colors (matching Windows 11 File Explorer) -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Row Hover/Selection Colors -->
            <Color x:Key="FileExplorerRowPointerOverColor">#E6F3FF</Color>
            <Color x:Key="FileExplorerRowPressedColor">#CCE8FF</Color>
            <Color x:Key="FileExplorerRowSelectedColor">#F3F3F3</Color>
            <Color x:Key="FileExplorerRowSelectedPointerOverColor">#E6F3FF</Color>
            <Color x:Key="FileExplorerRowSelectedPressedColor">#CCE8FF</Color>
            
            <!-- Background Colors -->
            <Color x:Key="FileExplorerBackgroundColor">#FFFFFF</Color>
            <Color x:Key="FileExplorerAlternateRowColor">#FFFFFF</Color>
            <Color x:Key="FileExplorerSidebarBackgroundColor">#FFFFFF</Color>
            <Color x:Key="FileExplorerTitleBarBackgroundColor">#F3F3F3</Color>
            
            <!-- Header Colors (Light blue like File Explorer) -->
            <Color x:Key="FileExplorerHeaderBackgroundColor">#F3F9FF</Color>
            <Color x:Key="FileExplorerHeaderHoverColor">#E6F3FF</Color>

            <!-- Header Brushes -->
            <SolidColorBrush x:Key="TableViewHeaderBackgroundPointerOver" Color="{ThemeResource FileExplorerHeaderHoverColor}" />
            <SolidColorBrush x:Key="TableViewHeaderBackgroundPressed" Color="{ThemeResource FileExplorerHeaderHoverColor}" Opacity="0.8" />
            
            <!-- Border Colors -->
            <Color x:Key="FileExplorerBorderColor">#E0E0E0</Color>
            
            <!-- Text Colors -->
            <Color x:Key="FileExplorerTextColor">#000000</Color>
            <Color x:Key="FileExplorerSubtleTextColor">#605E5C</Color>
            <Color x:Key="FileExplorerHeaderTextColor">#242424</Color>
            
            <!-- Button Hover Colors -->
            <Color x:Key="FileExplorerButtonHoverColor">#E6E6E6</Color>
            <Color x:Key="FileExplorerButtonPressedColor">#D4D4D4</Color>
            
            <!-- Sidebar Item Hover Colors -->
            <Color x:Key="FileExplorerSidebarItemHoverColor">#E6F3FF</Color>
            <Color x:Key="FileExplorerSidebarItemPressedColor">#CCE8FF</Color>
            <Color x:Key="FileExplorerSidebarItemSelectedColor">#F3F3F3</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Row Hover/Selection Colors (matching Windows 11 Dark Mode File Explorer) -->
            <Color x:Key="FileExplorerRowPointerOverColor">#2B2B2B</Color>
            <Color x:Key="FileExplorerRowPressedColor">#3A3A3A</Color>
            <Color x:Key="FileExplorerRowSelectedColor">#2B2B2B</Color>
            <Color x:Key="FileExplorerRowSelectedPointerOverColor">#2B2B2B</Color>
            <Color x:Key="FileExplorerRowSelectedPressedColor">#3A3A3A</Color>
            
            <!-- Background Colors -->
            <Color x:Key="FileExplorerBackgroundColor">#1E1E1E</Color>
            <Color x:Key="FileExplorerAlternateRowColor">#1E1E1E</Color>
            <Color x:Key="FileExplorerSidebarBackgroundColor">#1E1E1E</Color>
            <Color x:Key="FileExplorerTitleBarBackgroundColor">#1C1C1C</Color>
            
            <!-- Border Colors -->

            <!-- Header Colors -->
            <Color x:Key="FileExplorerHeaderBackgroundColor">#2B2B2B</Color>
            <Color x:Key="FileExplorerHeaderHoverColor">#3A3A3A</Color>

            <!-- Header Brushes -->
            <SolidColorBrush x:Key="TableViewHeaderBackgroundPointerOver" Color="{ThemeResource FileExplorerHeaderHoverColor}" />
            <SolidColorBrush x:Key="TableViewHeaderBackgroundPressed" Color="{ThemeResource FileExplorerHeaderHoverColor}" Opacity="0.8" />
            <Color x:Key="FileExplorerBorderColor">#323232</Color>
            
            <!-- Text Colors -->
            <Color x:Key="FileExplorerTextColor">#FFFFFF</Color>
            <Color x:Key="FileExplorerSubtleTextColor">#B0B0B0</Color>
            <Color x:Key="FileExplorerHeaderTextColor">#FFFFFF</Color>
            
            <!-- Button Hover Colors -->
            <Color x:Key="FileExplorerButtonHoverColor">#2D2D2D</Color>
            <Color x:Key="FileExplorerButtonPressedColor">#3A3A3A</Color>
            
            <!-- Sidebar Item Hover Colors -->
            <Color x:Key="FileExplorerSidebarItemHoverColor">#2B2B2B</Color>
            <Color x:Key="FileExplorerSidebarItemPressedColor">#3A3A3A</Color>
            <Color x:Key="FileExplorerSidebarItemSelectedColor">#2B2B2B</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <!-- High Contrast Colors (inherit system colors) -->
            <Color x:Key="FileExplorerRowPointerOverColor">Transparent</Color>
            <Color x:Key="FileExplorerRowPressedColor">Transparent</Color>
            <Color x:Key="FileExplorerRowSelectedColor">Transparent</Color>
            <Color x:Key="FileExplorerRowSelectedPointerOverColor">Transparent</Color>
            <Color x:Key="FileExplorerRowSelectedPressedColor">Transparent</Color>
            
            <Color x:Key="FileExplorerBackgroundColor">Transparent</Color>
            <Color x:Key="FileExplorerAlternateRowColor">Transparent</Color>
            <Color x:Key="FileExplorerSidebarBackgroundColor">Transparent</Color>
            <Color x:Key="FileExplorerTitleBarBackgroundColor">Transparent</Color>
            
            <Color x:Key="FileExplorerBorderColor">Transparent</Color>
            
            <Color x:Key="FileExplorerTextColor">Transparent</Color>
            <Color x:Key="FileExplorerSubtleTextColor">Transparent</Color>
            
            <Color x:Key="FileExplorerButtonHoverColor">Transparent</Color>
            <Color x:Key="FileExplorerButtonPressedColor">Transparent</Color>
            
            <Color x:Key="FileExplorerSidebarItemHoverColor">Transparent</Color>
            <Color x:Key="FileExplorerSidebarItemPressedColor">Transparent</Color>
            <Color x:Key="FileExplorerSidebarItemSelectedColor">Transparent</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

