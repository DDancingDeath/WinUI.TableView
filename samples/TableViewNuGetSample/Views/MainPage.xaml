<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="TableViewNuGetSample.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TableViewNuGetSample.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tableView="using:WinUI.TableView"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ExplorerNameTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="{Binding IconGlyph}" FontSize="14" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TaskNameTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="{Binding IconGlyph}" FontSize="14" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        
        <!-- Freezing row details demo during horizonatal scolling--> 
        <DataTemplate x:Key="ProductDetailsTemplate">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Margin="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="Product Details" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Price:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="$" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Price}" FontWeight="SemiBold" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Stock Level:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Stock}" FontWeight="SemiBold" />
                            <TextBlock Text="units available" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Page.Content>
        <Grid Padding="20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock FontSize="20" FontWeight="SemiBold" Text="WinUI.TableView Samples" VerticalAlignment="Center" />

                <ToggleSwitch x:Name="ThemeToggleSwitch"
                              Grid.Column="1"
                              Header="Dark mode"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Toggled="OnThemeToggleToggled" />
            </Grid>

            <TabView Grid.Row="1">
                <TabViewItem Header="Features Demo">
                    <Grid Padding="8">
                        <tableView:TableView
                            AutoGenerateColumns="False"
                            ItemsSource="{x:Bind ProductRows}"
                            AlternateRowBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerButtonMode="Options"
                            ShowExportOptions="True"
                            SelectionMode="Single">
                            <tableView:TableView.Columns>
                                <tableView:TableViewTextColumn Header="Product" Binding="{Binding Name}" MinWidth="200" />
                                <tableView:TableViewTextColumn Header="Category" Binding="{Binding Category}" MinWidth="140" />
                                <tableView:TableViewNumberColumn Header="Price" Binding="{Binding Price}" MinWidth="100" />
                                <tableView:TableViewNumberColumn Header="Stock" Binding="{Binding Stock}" MinWidth="90" />
                                <tableView:TableViewCheckBoxColumn Header="Available" Binding="{Binding IsAvailable}" MinWidth="100" />
                                <tableView:TableViewDateColumn Header="Added" Binding="{Binding DateAdded}" MinWidth="140" />
                                <tableView:TableViewComboBoxColumn Header="Rating" Binding="{Binding Rating}" MinWidth="120"
                                    ItemsSource="{x:Bind RatingOptions}" />
                            </tableView:TableView.Columns>
                        </tableView:TableView>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="File Explorer">
                    <Grid Padding="8">
                        <tableView:TableView
                            AutoGenerateColumns="False"
                            GroupByPath="GroupLabel"
                            HeadersVisibility="Columns"
                            ItemsSource="{x:Bind ExplorerRows}"
                            RowHeight="34"
                            RowMinHeight="30"
                            SelectionMode="Single"
                            ShowGroupItemCount="False">
                            <tableView:TableView.Columns>
                                <tableView:TableViewTemplateColumn Header="Name" CellTemplate="{StaticResource ExplorerNameTemplate}" MinWidth="340" />
                                <tableView:TableViewTextColumn Header="Date modified" Binding="{Binding DateModified}" MinWidth="170" />
                                <tableView:TableViewTextColumn Header="Type" Binding="{Binding Type}" MinWidth="180" />
                                <tableView:TableViewTextColumn Header="Size" Binding="{Binding Size}" MinWidth="120" />
                            </tableView:TableView.Columns>
                        </tableView:TableView>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="Task Manager">
                    <Grid Padding="8">
                        <tableView:TableView
                            AutoGenerateColumns="False"
                            ChildrenPath="Children"
                            GroupByPath="Category"
                            HeadersVisibility="Columns"
                            IndentSize="14"
                            IsExpandedPath="IsExpanded"
                            IsHierarchicalEnabled="True"
                            ItemsSource="{x:Bind TaskRows}"
                            RowHeight="34"
                            RowMinHeight="30"
                            SelectionMode="Single"
                            ShowGroupItemCount="True">
                            <tableView:TableView.Columns>
                                <tableView:TableViewTemplateColumn Header="Name" CellTemplate="{StaticResource TaskNameTemplate}" MinWidth="300" />
                                <tableView:TableViewTextColumn Header="Status" Binding="{Binding Status}" MinWidth="140" />
                                <tableView:TableViewTextColumn Header="CPU" Binding="{Binding Cpu}" MinWidth="90" />
                                <tableView:TableViewTextColumn Header="Memory" Binding="{Binding Memory}" MinWidth="130" />
                                <tableView:TableViewTextColumn Header="Disk" Binding="{Binding Disk}" MinWidth="100" />
                                <tableView:TableViewTextColumn Header="Network" Binding="{Binding Network}" MinWidth="110" />
                            </tableView:TableView.Columns>
                        </tableView:TableView>
                    </Grid>
                </TabViewItem>
                
                <!-- Tab for testing frozen column demo + row details frozen feature -->
                <TabViewItem Header="Frozen Columns + Row Details">
                    <Grid Padding="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="8">
                            <TextBlock Text="Frozen Columns + Row Details Demo:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Text="First 2 columns frozen. Click chevron to expand row details." 
                                       VerticalAlignment="Center" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="8,0">
                            <ToggleSwitch x:Name="FreezeRowDetailsToggle" 
                                          Header="Freeze Row Details"
                                          IsOn="False"
                                          OnContent="Details stay fixed"
                                          OffContent="Details scroll with columns" />
                            <TextBlock VerticalAlignment="Center" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxWidth="400">
                                <Run Text="Toggle to see the difference: When ON, row details stay in a fixed position. When OFF, they scroll horizontally with the columns." />
                            </TextBlock>
                        </StackPanel>

                        <tableView:TableView
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            ItemsSource="{x:Bind ProductRows}"
                            AlternateRowBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            FrozenColumnCount="2"
                            RowDetailsVisibilityMode="VisibleWhenExpanded"
                            RowDetailsTemplate="{StaticResource ProductDetailsTemplate}"
                            AreRowDetailsFrozen="{x:Bind FreezeRowDetailsToggle.IsOn, Mode=OneWay}"
                            SelectionMode="Single">
                            <tableView:TableView.Columns>
                                <tableView:TableViewTextColumn Header="Product" Binding="{Binding Name}" MinWidth="200" />
                                <tableView:TableViewTextColumn Header="Category" Binding="{Binding Category}" MinWidth="140" />
                                <tableView:TableViewNumberColumn Header="Price" Binding="{Binding Price}" MinWidth="120" />
                                <tableView:TableViewNumberColumn Header="Stock" Binding="{Binding Stock}" MinWidth="120" />
                                <tableView:TableViewCheckBoxColumn Header="Available" Binding="{Binding IsAvailable}" MinWidth="120" />
                                <tableView:TableViewDateColumn Header="Added" Binding="{Binding DateAdded}" MinWidth="160" />
                                <tableView:TableViewComboBoxColumn Header="Rating" Binding="{Binding Rating}" MinWidth="140"
                                    ItemsSource="{x:Bind RatingOptions}" />
                            </tableView:TableView.Columns>
                        </tableView:TableView>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Grid>
    </Page.Content>
</Page>
