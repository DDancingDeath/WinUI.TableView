<ResourceDictionary
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:tableView="using:WinUI.TableView">

    <!-- Light Theme Colors (matching Windows 11 File Explorer) -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Row Hover/Selection Colors -->
            <Color x:Key="FileExplorerRowPointerOverColor">#E6F3FF</Color>
            <Color x:Key="FileExplorerRowPressedColor">#CCE8FF</Color>
            <Color x:Key="FileExplorerRowSelectedColor">#F3F3F3</Color>
            <Color x:Key="FileExplorerRowSelectedPointerOverColor">#E6F3FF</Color>
            <Color x:Key="FileExplorerRowSelectedPressedColor">#CCE8FF</Color>
            
            <!-- Background Colors -->
            <Color x:Key="FileExplorerBackgroundColor">#FFFFFF</Color>
            <Color x:Key="FileExplorerAlternateRowColor">#FFFFFF</Color>
            <Color x:Key="FileExplorerSidebarBackgroundColor">#FFFFFF</Color>
            <Color x:Key="FileExplorerTitleBarBackgroundColor">#F3F3F3</Color>
            
            <!-- Header Colors (Light blue like File Explorer) -->
            <Color x:Key="FileExplorerHeaderBackgroundColor">#F3F9FF</Color>
            <Color x:Key="FileExplorerHeaderHoverColor">#E6F3FF</Color>
            
            <!-- Border Colors -->
            <Color x:Key="FileExplorerBorderColor">#E0E0E0</Color>
            
            <!-- Text Colors -->
            <Color x:Key="FileExplorerTextColor">#000000</Color>
            <Color x:Key="FileExplorerSubtleTextColor">#605E5C</Color>
            <Color x:Key="FileExplorerHeaderTextColor">#242424</Color>
            
            <!-- Button Hover Colors -->
            <Color x:Key="FileExplorerButtonHoverColor">#E6E6E6</Color>
            <Color x:Key="FileExplorerButtonPressedColor">#D4D4D4</Color>
            
            <!-- Sidebar Item Hover Colors -->
            <Color x:Key="FileExplorerSidebarItemHoverColor">#E6F3FF</Color>
            <Color x:Key="FileExplorerSidebarItemPressedColor">#CCE8FF</Color>
            <Color x:Key="FileExplorerSidebarItemSelectedColor">#F3F3F3</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Row Hover/Selection Colors (matching Windows 11 Dark Mode File Explorer) -->
            <Color x:Key="FileExplorerRowPointerOverColor">#2B2B2B</Color>
            <Color x:Key="FileExplorerRowPressedColor">#3A3A3A</Color>
            <Color x:Key="FileExplorerRowSelectedColor">#2B2B2B</Color>
            <Color x:Key="FileExplorerRowSelectedPointerOverColor">#2B2B2B</Color>
            <Color x:Key="FileExplorerRowSelectedPressedColor">#3A3A3A</Color>
            
            <!-- Background Colors -->
            <Color x:Key="FileExplorerBackgroundColor">#1E1E1E</Color>
            <Color x:Key="FileExplorerAlternateRowColor">#1E1E1E</Color>
            <Color x:Key="FileExplorerSidebarBackgroundColor">#1E1E1E</Color>
            <Color x:Key="FileExplorerTitleBarBackgroundColor">#1C1C1C</Color>
            
            <!-- Border Colors -->
            <Color x:Key="FileExplorerBorderColor">#323232</Color>
            
            <!-- Text Colors -->
            <Color x:Key="FileExplorerTextColor">#FFFFFF</Color>
            <Color x:Key="FileExplorerSubtleTextColor">#B0B0B0</Color>
            <Color x:Key="FileExplorerHeaderTextColor">#FFFFFF</Color>
            
            <!-- Button Hover Colors -->
            <Color x:Key="FileExplorerButtonHoverColor">#2D2D2D</Color>
            <Color x:Key="FileExplorerButtonPressedColor">#3A3A3A</Color>
            
            <!-- Sidebar Item Hover Colors -->
            <Color x:Key="FileExplorerSidebarItemHoverColor">#2B2B2B</Color>
            <Color x:Key="FileExplorerSidebarItemPressedColor">#3A3A3A</Color>
            <Color x:Key="FileExplorerSidebarItemSelectedColor">#2B2B2B</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <!-- High Contrast Colors (inherit system colors) -->
            <Color x:Key="FileExplorerRowPointerOverColor">Transparent</Color>
            <Color x:Key="FileExplorerRowPressedColor">Transparent</Color>
            <Color x:Key="FileExplorerRowSelectedColor">Transparent</Color>
            <Color x:Key="FileExplorerRowSelectedPointerOverColor">Transparent</Color>
            <Color x:Key="FileExplorerRowSelectedPressedColor">Transparent</Color>
            
            <Color x:Key="FileExplorerBackgroundColor">Transparent</Color>
            <Color x:Key="FileExplorerAlternateRowColor">Transparent</Color>
            <Color x:Key="FileExplorerSidebarBackgroundColor">Transparent</Color>
            <Color x:Key="FileExplorerTitleBarBackgroundColor">Transparent</Color>
            
            <Color x:Key="FileExplorerBorderColor">Transparent</Color>
            
            <Color x:Key="FileExplorerTextColor">Transparent</Color>
            <Color x:Key="FileExplorerSubtleTextColor">Transparent</Color>
            
            <Color x:Key="FileExplorerButtonHoverColor">Transparent</Color>
            <Color x:Key="FileExplorerButtonPressedColor">Transparent</Color>
            
            <Color x:Key="FileExplorerSidebarItemHoverColor">Transparent</Color>
            <Color x:Key="FileExplorerSidebarItemPressedColor">Transparent</Color>
            <Color x:Key="FileExplorerSidebarItemSelectedColor">Transparent</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Brush Resources (automatically switch based on theme) -->
    <SolidColorBrush x:Key="FileExplorerRowPointerOverBrush" Color="{ThemeResource FileExplorerRowPointerOverColor}" />
    <SolidColorBrush x:Key="FileExplorerRowPressedBrush" Color="{ThemeResource FileExplorerRowPressedColor}" />
    <SolidColorBrush x:Key="FileExplorerRowSelectedBrush" Color="{ThemeResource FileExplorerRowSelectedColor}" />
    <SolidColorBrush x:Key="FileExplorerRowSelectedPointerOverBrush" Color="{ThemeResource FileExplorerRowSelectedPointerOverColor}" />
    <SolidColorBrush x:Key="FileExplorerRowSelectedPressedBrush" Color="{ThemeResource FileExplorerRowSelectedPressedColor}" />
    
    <SolidColorBrush x:Key="FileExplorerBackgroundBrush" Color="{ThemeResource FileExplorerBackgroundColor}" />
    <SolidColorBrush x:Key="FileExplorerAlternateRowBrush" Color="{ThemeResource FileExplorerAlternateRowColor}" />
    <SolidColorBrush x:Key="FileExplorerSidebarBackgroundBrush" Color="{ThemeResource FileExplorerSidebarBackgroundColor}" />
    <SolidColorBrush x:Key="FileExplorerTitleBarBackgroundBrush" Color="{ThemeResource FileExplorerTitleBarBackgroundColor}" />
    
    <!-- Header Brushes -->
    <SolidColorBrush x:Key="FileExplorerHeaderBackgroundBrush" Color="{ThemeResource FileExplorerHeaderBackgroundColor}" />
    <SolidColorBrush x:Key="FileExplorerHeaderHoverBrush" Color="{ThemeResource FileExplorerHeaderHoverColor}" />
    
    <SolidColorBrush x:Key="FileExplorerBorderBrush" Color="{ThemeResource FileExplorerBorderColor}" />
    
    <SolidColorBrush x:Key="FileExplorerTextBrush" Color="{ThemeResource FileExplorerTextColor}" />
    <SolidColorBrush x:Key="FileExplorerSubtleTextBrush" Color="{ThemeResource FileExplorerSubtleTextColor}" />
    <SolidColorBrush x:Key="FileExplorerHeaderTextBrush" Color="{ThemeResource FileExplorerHeaderTextColor}" />
    
    <SolidColorBrush x:Key="FileExplorerButtonHoverBrush" Color="{ThemeResource FileExplorerButtonHoverColor}" />
    <SolidColorBrush x:Key="FileExplorerButtonPressedBrush" Color="{ThemeResource FileExplorerButtonPressedColor}" />
    
    <SolidColorBrush x:Key="FileExplorerSidebarItemHoverBrush" Color="{ThemeResource FileExplorerSidebarItemHoverColor}" />
    <SolidColorBrush x:Key="FileExplorerSidebarItemPressedBrush" Color="{ThemeResource FileExplorerSidebarItemPressedColor}" />
    <SolidColorBrush x:Key="FileExplorerSidebarItemSelectedBrush" Color="{ThemeResource FileExplorerSidebarItemSelectedColor}" />

    <!-- Custom ListViewItem Style for File Explorer -->
    <Style x:Key="FileExplorerListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="ContentBorder"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerRowPointerOverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerRowPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerRowSelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerRowSelectedPointerOverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerRowSelectedPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar ListViewItem Style -->
    <Style x:Key="FileExplorerSidebarListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="ContentBorder"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="4"
                          Margin="4,1">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerSidebarItemHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerSidebarItemPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerSidebarItemSelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerSidebarItemHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerSidebarItemPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subtle Button Style (for toolbar buttons) -->
    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource FileExplorerButtonHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource FileExplorerButtonPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GridViewItem Style for Icon/Tiles/Content Views -->
    <Style x:Key="FileExplorerGridViewItemStyle" TargetType="GridViewItem">
        <Setter Property="Margin" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <Grid x:Name="ContentBorder"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="4">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerRowPointerOverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerRowPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerRowSelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerRowSelectedPointerOverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentBorder.Background" Value="{ThemeResource FileExplorerRowSelectedPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom TableViewColumnHeader Style for File Explorer with larger filter dropdown -->
    <Style x:Key="FileExplorerTableViewColumnHeaderStyle" TargetType="tableView:TableViewColumnHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        <Setter Property="Foreground" Value="{ThemeResource TableViewHeaderForeground}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Opacity="0" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>


